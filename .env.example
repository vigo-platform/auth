# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# RSA Key Configuration for JWT & JWKS
JWT_PRIVATE_KEY_PATH=.keys/private_key.pem
JWT_PUBLIC_KEY_PATH=.keys/public_key.pem
JWT_KEY_ID=vigo-auth-key-1

# User service gRPC (internal plaintext connection)
USER_GRPC_HOST=localhost
USER_GRPC_PORT=50051
USER_GRPC_TIMEOUT_MS=3000
