# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# RSA Key Configuration for JWT & JWKS
JWT_PRIVATE_KEY_PATH=.keys/private_key.pem
JWT_PUBLIC_KEY_PATH=.keys/public_key.pem
JWT_KEY_ID=vigo-auth-key-1
JWT_ISSUER=auth.vigoapp.ir
JWT_AUDIENCE=vigo-api
JWT_ACCESS_TOKEN_TTL=15m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# Audit-log identifier fingerprints only; not used by Redis or OTP verification.
# Generate a separate secret with: openssl rand -base64 32
# Required: replace this placeholder and use the same secret on all Auth instances.
AUTH_OTP_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_SECRET
# User contract has no per-user MFA flag; this controls OTP after a correct password.
AUTH_PASSWORD_OTP_REQUIRED=false
AUTH_OTP_TTL=5m
AUTH_OTP_COOLDOWN=1m
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILURE_WINDOW=30m
AUTH_LOCK_DURATION=1m
AUTH_MAX_LOCK_DURATION=30m
AUTH_IP_MAX_REQUESTS=60
AUTH_IP_WINDOW=1m
AUTH_REFRESH_TOKEN_TTL=7d
AUTH_SESSION_TTL=30d
# Delay after session expiry before revoking the session and its tokens; records are not deleted.
AUTH_RETENTION=7d
AUTH_CLEANUP_INTERVAL=1h

# User service gRPC (internal plaintext connection)
USER_GRPC_HOST=localhost
USER_GRPC_PORT=50051
USER_GRPC_TIMEOUT_MS=3000

# Initial auth settings (for creating a missing settings record)
AUTH_DEFAULT_LOGIN_ENABLED=true
AUTH_DEFAULT_REGISTER_ENABLED=true
# Supported OTP channels: EMAIL, SMS, IN_APP
AUTH_DEFAULT_OTP_CHANNEL=EMAIL
AUTH_DEFAULT_EMAIL_NOTIFICATION_ENABLED=false
AUTH_DEFAULT_SMS_NOTIFICATION_ENABLED=false
AUTH_DEFAULT_IN_APP_NOTIFICATION_ENABLED=false
